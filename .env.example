# ── Global Chronicle News — Environment Configuration ────────────────────────
# Copy this file to .env and fill in all required values.
# Never commit .env to version control.
#
# Generate a secure JWT_SECRET:
#   npm run gen:secret
#   OR: openssl rand -hex 48

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED in production. Min 32 characters. Must not be a known default.
# Production startup will throw if this is missing, too short, or insecure.
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_npm_run_gen_secret

# Token lifetime in seconds. Default 28800 (8 hours). Max 86400 (24 h).
# Use shorter values in high-security environments; call POST /api/auth/refresh
# before expiry to renew without re-login.
JWT_EXPIRES_IN_SECONDS=28800

# ── Database ─────────────────────────────────────────────────────────────────
# Persistence driver (Phase 6B, src/lib/database.ts):
#   postgres → Prisma/PostgreSQL (REQUIRED in production; see DATABASE_URL below)
#   json     → legacy JSON file store at data/database.json
#              (development/test only — production refuses to start with 'json')
# Omitted in development: defaults to json. Omitted in production: defaults to
# postgres and startup fails closed if PostgreSQL is not configured.
DB_DRIVER=json

# PostgreSQL connection string. Required when DB_DRIVER=postgres and in
# production. The server starts only after migrations were applied:
#   npm run db:migrate:deploy   (applies prisma/migrations)
#   npm run db:import           (one-time JSON → PostgreSQL import, never overwrites)
#   npm run db:verify           (post-import checks; run before cutover)
DATABASE_URL=postgresql://user:password@localhost:5432/global_chronicle

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# All SMTP_* are optional in development — reset links are logged to the console.
# In PRODUCTION, all four must be set or password reset will return 503.
# The server NEVER claims an email was sent unless delivery is confirmed.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@globalchronicle.news
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=noreply@globalchronicle.news

# ── AI Assistant ─────────────────────────────────────────────────────────────
# Required only for AI summarise / headline / TTS features.
GEMINI_API_KEY=

# ── Application URL ───────────────────────────────────────────────────────────
# Used in password-reset email links. Must match the public-facing URL.
APP_URL=http://localhost:3000

# ── Secret rotation procedure ────────────────────────────────────────────────
# 1. Generate a new secret:  npm run gen:secret
# 2. Update JWT_SECRET in your secret manager / deployment environment.
# 3. Restart the server — all existing sessions will be invalidated immediately
#    because old tokens will fail the new-secret verification.
# 4. Users will be prompted to sign in again. Communicate rotation in advance.
