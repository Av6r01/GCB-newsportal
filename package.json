{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:routes": "tsx scripts/route-lint.ts",
    "test": "tsx tests/bootstrap.test.ts && tsx tests/integrity.test.ts && tsx tests/authorization.test.ts && tsx tests/adminShell.test.ts && tsx tests/taxonomy.test.ts && tsx tests/articleEditor.test.ts && tsx tests/workflow.test.ts && tsx tests/qa.test.ts",
    "seed": "NODE_ENV=development tsx -e \"import('./src/lib/seed.ts').then(m => m.seedDevelopmentData()).then(() => { console.log('Seed complete'); process.exit(0); }).catch(e => { console.error(e); process.exit(1); })\"",
    "test:security": "npx tsx tests/security/A-unpublished-article-exposure.test.ts && npx tsx tests/security/BCDEFG-access-control.test.ts && npx tsx tests/security/HIJ-auth-and-reset.test.ts && npx tsx tests/security/KLM-ratelimit-tts-svg.test.ts && npx tsx tests/security/phase4-auth-hardening.test.ts",
    "test:all": "npm test && npm run test:security && npm run test:p7 && npm run test:p8 && npm run test:p9 && npm run test:p10 && npm run test:p11 && npm run test:p13",
    "test:p7": "tsx tests/p7/run.ts",
    "test:p8": "tsx tests/p8/run.ts",
    "test:p9": "tsx tests/p9/run.ts",
    "test:p10": "tsx tests/p10/run.ts",
    "test:p11": "tsx tests/p11/run.ts",
    "test:p13": "tsx tests/p13/critical-e2e.test.ts",
    "test:persistence": "tsx tests/persistence/run.ts",
    "db:import": "tsx src/db-migration/import-json-to-pg.ts",
    "db:verify": "tsx src/db-migration/verify-pg.ts",
    "db:export": "tsx src/db-migration/export-from-json.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "gen:secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "6.19.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/dompurify": "^3.2.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/nodemailer": "^8.0.2",
    "@types/react-helmet": "^6.1.11",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-react-parser": "^6.1.9",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "morgan": "^1.12.1",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet": "^6.1.0",
    "react-twitter-embed": "^4.0.4",
    "react-twitter-widgets": "^1.11.0",
    "react-youtube": "^10.1.0",
    "sanitize-html": "^2.18.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
